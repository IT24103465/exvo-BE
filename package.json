{
  "name": "exvo-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Development scripts for the Exvo .NET platform",
  "scripts": {
    "restore": "dotnet restore ExvoPlatform.sln",
    "build": "dotnet build ExvoPlatform.sln",
    "test": "dotnet test ExvoPlatform.sln",
    "check": "npm run build && npm run test",
    "load:validate": "node tests/load/run-jmeter.mjs --validate",
    "load:gui": "node tests/load/run-jmeter.mjs --gui",
    "load:smoke": "node tests/load/run-jmeter.mjs --profile smoke",
    "load:demo": "node tests/load/run-jmeter.mjs --profile demo",
    "load:test": "node tests/load/run-jmeter.mjs --profile load",
    "load:stress": "node tests/load/run-jmeter.mjs --profile stress"
  }
}
