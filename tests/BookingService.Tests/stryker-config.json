{
  "stryker-config": {
    "project": "Exvo.BookingService.csproj",
    "configuration": "Release",
    "target-framework": "net8.0",
    "concurrency": 2,
    "additional-timeout": 10000,
    "mutate": [
      "**/Services/EventInventoryCatalogClient.cs"
    ],
    "coverage-analysis": "perTest",
    "test-case-filter": "FullyQualifiedName~EventInventoryCatalogClientTests|FullyQualifiedName~TicketQuantityUnitTests|FullyQualifiedName~CatalogErrorUnitTests",
    "thresholds": {
      "high": 90,
      "low": 80,
      "break": 80
    },
    "reporters": [
      "Progress",
      "Html",
      "Json"
    ],
    "report-file-name": "mutation-report",
    "break-on-initial-test-failure": true
  }
}
