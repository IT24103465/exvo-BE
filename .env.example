# Azure MySQL settings used by Docker Compose.
AZURE_MYSQL_HOST=exvo-db.mysql.database.azure.com
AZURE_MYSQL_PORT=3306
AZURE_MYSQL_USER=exvoadmin
AZURE_MYSQL_PASSWORD=YOUR_AZURE_MYSQL_PASSWORD

# Compose also uses AZURE_MYSQL_PASSWORD for the dedicated local Booking and Check-In databases.
# Service connection strings are supplied by docker-compose.yml.

# Booking confirmation email settings.
# If EMAIL_HOST is empty, BookingService writes emails to notifications-outbox instead of sending SMTP.
# SMTP examples: set the corresponding values below to enable email sending.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_USERNAME=your-email@gmail.com
# EMAIL_PASSWORD=your-email-app-password
# EMAIL_FROM=your-email@gmail.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_ENABLE_SSL=true
EMAIL_PICKUP_DIRECTORY=notifications-outbox
