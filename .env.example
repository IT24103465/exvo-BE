# Azure MySQL settings used by Docker Compose.
AZURE_MYSQL_HOST=exvo-db.mysql.database.azure.com
AZURE_MYSQL_PORT=3306
AZURE_MYSQL_USER=exvoadmin
AZURE_MYSQL_PASSWORD=YOUR_AZURE_MYSQL_PASSWORD

# BookingService uses the same Azure MySQL Flexible Server and a separate database.
EXVO_BOOKING_MYSQL_CONNECTION_STRING=Server=${AZURE_MYSQL_HOST};Port=${AZURE_MYSQL_PORT};Database=exvo_booking_db;User ID=${AZURE_MYSQL_USER};Password=${AZURE_MYSQL_PASSWORD};SslMode=Required;

# Optional local MySQL fallback. Only used with: docker compose --profile local up
LOCAL_MYSQL_ROOT_PASSWORD=YOUR_LOCAL_MYSQL_ROOT_PASSWORD
