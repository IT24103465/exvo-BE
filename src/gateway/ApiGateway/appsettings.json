{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        }
      },
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/booking/{**catch-all}"
        }
      },
      "checkin-route": {
        "ClusterId": "checkin-cluster",
        "Match": {
          "Path": "/api/checkin/{**catch-all}"
        }
      },
      "coordinator-route": {
        "ClusterId": "checkin-cluster",
        "Match": {
          "Path": "/api/coordinator/{**catch-all}"
        }
      },
      "reports-route": {
        "ClusterId": "checkin-cluster",
        "Match": {
          "Path": "/api/reports/{**catch-all}"
        }
      },
      "analytics-route": {
        "ClusterId": "checkin-cluster",
        "Match": {
          "Path": "/api/analytics/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "authServiceDestination": {
            "Address": "http://localhost:5284"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalogServiceDestination": {
            "Address": "http://localhost:5255"
          }
        }
      },
      "booking-cluster": {
        "Destinations": {
          "bookingServiceDestination": {
            "Address": "http://localhost:5266"
          }
        }
      },
      "checkin-cluster": {
        "Destinations": {
          "checkinServiceDestination": {
            "Address": "http://localhost:5028"
          }
        }
      }
    }
  }
}
